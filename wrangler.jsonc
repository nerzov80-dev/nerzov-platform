{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nerzov-platform",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-app",
    "run_worker_first": [
      "/api/*",
      "/lp/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nerzov-db",
      "database_id": "df012dd0-08e4-4eaf-96e4-3e929ea08e57",
      "migrations_dir": "server/db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "854e18e68c4b40b6a36ae26ea1dc17c2"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "nerzov-images"
    }
  ]
}
